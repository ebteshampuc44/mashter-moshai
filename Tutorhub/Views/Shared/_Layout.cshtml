                    else
                    {
                        <div class="flex flex-col gap-2">
                            <a asp-controller="Account" asp-action="Login" class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-full font-semibold text-white text-sm" style="background-color:var(--primary-color);">
