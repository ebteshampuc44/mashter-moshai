@* 📁 Views/Shared/_Layout.cshtml *@
@using Tutorbub.Models
@{
    // ✅ সাইট সেটিংস লোড (থিম কালার, লোগো, সাইট নামের জন্য)
    var layoutSettings = new SiteSettings();
    try
    {
        var cfg = Context.RequestServices.GetService<IConfiguration>();
        if (cfg != null)
        {
            var db = new DatabaseHelper(cfg);
            layoutSettings = db.GetSiteSettings();
        }
    }
    catch { }

    // ✅ Admin page হলে Footer hide করা হবে
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAdminPage = currentController.Equals("Admin", StringComparison.OrdinalIgnoreCase);

    // ✅ Branding helpers
    var safeSiteName = layoutSettings.GetSafeSiteName();
    var navbarLogo = layoutSettings.GetNavbarLogo();
    var footerLogo = layoutSettings.GetFooterLogo();
    var safeLogoSize = layoutSettings.GetSafeLogoSize();
    var logoRadius = layoutSettings.GetLogoBorderRadius();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @safeSiteName</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            primary: '@layoutSettings.PrimaryColor',
                            cream: '@layoutSettings.SecondaryColor'
                        },
                        fontFamily: {
                            serif: ['Georgia', 'Cambria', '"Times New Roman"', 'Times', 'serif']
                        }
                    }
                }
            }
    </script>

    <script>
            if (!('PageSwapEvent' in window)) document.documentElement.classList.add('no-vt');
    </script>

    <script type="speculationrules">
            {
                "prefetch": [
                    {
                        "where": {
                            "and": [
                                { "href_matches": "/*" },
                                { "not": { "selector_matches": "[data-no-prefetch], [download], [target=_blank]" } }
                            ]
                        },
                        "eagerness": "moderate"
                    }
                ]
            }
    </script>

    <style>
            /* ===== Theme Variables (Admin Settings থেকে লোড) ===== */
            :root {
                --primary-color: @layoutSettings.PrimaryColor;
                --secondary-color: @layoutSettings.SecondaryColor;
                --accent-color: @layoutSettings.AccentColor;
                --text-color: @layoutSettings.TextColor;
                --navbar-bg: @layoutSettings.NavbarBgColor;
                --footer-bg: @layoutSettings.FooterBgColor;
            }

            body {
                background-color: var(--secondary-color);
            }

            .navbar-custom {
                background-color: var(--navbar-bg) !important;
                border-bottom: 1px solid rgba(0,0,0,0.05);
            }

            .btn-primary-custom {
                background-color: var(--primary-color) !important;
                border-color: var(--primary-color) !important;
            }

                .btn-primary-custom:hover {
                    opacity: 0.9;
                }

            .text-primary-custom {
                color: var(--primary-color) !important;
            }

            .bg-primary-custom {
                background-color: var(--primary-color) !important;
            }

            .border-primary-custom {
                border-color: var(--primary-color) !important;
            }

            .footer-custom {
                background-color: var(--footer-bg);
                border-top: 1px solid rgba(0,0,0,0.05);
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: rgba(0, 0, 0, 0.5);
                z-index: 99;
            }

                .sidebar-overlay.active {
                    display: block;
                }

            .page-content {
                padding-top: 80px;
            }

            .admin-page .main-content {
                margin-left: 250px;
                padding: 20px;
                min-height: calc(100vh - 80px);
            }

            @@media (max-width: 992px) {
                .admin-page .main-content {
                    margin-left: 0;
                    padding: 20px 15px;
                }
            }

            /* ===== Navbar overlap/wrap fix ===== */
            .nav-desktop-link {
                white-space: nowrap;
                flex-shrink: 0;
            }

            .profile-dropdown .dropdown-toggle {
                white-space: nowrap;
            }

                .profile-dropdown .dropdown-toggle > span:not(.caret) {
                    max-width: 170px;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

            /* ===== ড্রপডাউন মেনু স্টাইল ===== */
            .profile-dropdown .dropdown-toggle {
                color: var(--primary-color) !important;
                text-decoration: none !important;
                font-weight: 500;
                transition: opacity 0.3s;
                background: none;
                border: none;
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 0;
                cursor: pointer;
            }

                .profile-dropdown .dropdown-toggle:hover {
                    opacity: 0.7;
                }

                .profile-dropdown .dropdown-toggle i {
                    font-size: 18px;
                }

                .profile-dropdown .dropdown-toggle .caret {
                    font-size: 12px;
                    margin-left: 4px;
                }

            .profile-dropdown .dropdown-menu {
                border: none;
                border-radius: 12px;
                box-shadow: 0 8px 30px rgba(0,0,0,0.12);
                padding: 8px 0;
                min-width: 240px;
                background: white;
                margin-top: 8px;
            }

                .profile-dropdown .dropdown-menu .dropdown-header {
                    padding: 10px 20px 6px;
                    font-weight: 600;
                    color: var(--primary-color);
                    border-bottom: 1px solid #f0f0f0;
                    margin-bottom: 4px;
                }

                    .profile-dropdown .dropdown-menu .dropdown-header small {
                        display: block;
                        font-weight: 400;
                        color: #6B7568;
                        font-size: 12px;
                    }

                .profile-dropdown .dropdown-menu .dropdown-item {
                    padding: 10px 20px;
                    color: #4B5648;
                    font-size: 14px;
                    font-weight: 500;
                    transition: all 0.2s;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                    .profile-dropdown .dropdown-menu .dropdown-item:hover {
                        background-color: var(--secondary-color);
                        color: var(--primary-color);
                    }

                    .profile-dropdown .dropdown-menu .dropdown-item i {
                        width: 20px;
                        text-align: center;
                        color: #6B7568;
                        font-size: 14px;
                    }

                    .profile-dropdown .dropdown-menu .dropdown-item:hover i {
                        color: var(--primary-color);
                    }

                .profile-dropdown .dropdown-menu .dropdown-divider {
                    margin: 4px 0;
                    border-color: #f0f0f0;
                }

                .profile-dropdown .dropdown-menu .dropdown-item.text-danger {
                    color: #e74c3c;
                }

                    .profile-dropdown .dropdown-menu .dropdown-item.text-danger i {
                        color: #e74c3c;
                    }

                    .profile-dropdown .dropdown-menu .dropdown-item.text-danger:hover {
                        background-color: #fde8e8;
                    }

                .profile-dropdown .dropdown-menu .dropdown-item .badge-role {
                    font-size: 10px;
                    padding: 2px 10px;
                    border-radius: 20px;
                    font-weight: 600;
                    background: #eef2f6;
                    color: #6B7568;
                    margin-left: auto;
                }

                    .profile-dropdown .dropdown-menu .dropdown-item .badge-role.teacher {
                        background: #d1ecf1;
                        color: #0c6b7c;
                    }

                    .profile-dropdown .dropdown-menu .dropdown-item .badge-role.admin {
                        background: #fff3cd;
                        color: #b8860b;
                    }

            .profile-dropdown .dropdown-menu {
                display: block;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all 0.2s ease;
                pointer-events: none;
            }

            .profile-dropdown.show .dropdown-menu {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
                pointer-events: auto;
            }

            /* ===== Notification Bell ===== */
            .notification-wrapper {
                position: relative;
                margin-right: 14px;
            }

            .notification-bell {
                background: none;
                border: none;
                color: var(--primary-color);
                font-size: 20px;
                cursor: pointer;
                position: relative;
                padding: 8px;
                transition: transform 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .notification-bell:hover {
                    transform: scale(1.1);
                }

                .notification-bell .notif-badge {
                    position: absolute;
                    top: 2px;
                    right: 0px;
                    background: #e74c3c;
                    color: white;
                    font-size: 10px;
                    font-weight: 700;
                    padding: 2px 6px;
                    border-radius: 10px;
                    min-width: 18px;
                    text-align: center;
                    border: 2px solid var(--navbar-bg);
                    display: none;
                }

                    .notification-bell .notif-badge.show {
                        display: block;
                    }

            .notif-dropdown {
                position: absolute;
                top: calc(100% + 8px);
                right: 0;
                width: 380px;
                max-width: 92vw;
                background: white;
                border-radius: 14px;
                box-shadow: 0 12px 40px rgba(0,0,0,0.15);
                border: 1px solid rgba(0,0,0,0.06);
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all 0.2s ease;
                pointer-events: none;
                z-index: 1000;
                overflow: hidden;
            }

            .notification-wrapper.show .notif-dropdown {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
                pointer-events: auto;
            }

            .notif-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 14px 18px;
                border-bottom: 1px solid #f0f0f0;
                background: #FAF9F4;
            }

                .notif-header h6 {
                    margin: 0;
                    font-size: 14px;
                    font-weight: 700;
                    color: var(--primary-color);
                }

            .notif-header-actions {
                display: flex;
                gap: 8px;
            }

                .notif-header-actions button {
                    background: none;
                    border: none;
                    color: var(--primary-color);
                    font-size: 11px;
                    font-weight: 600;
                    cursor: pointer;
                    padding: 4px 8px;
                    border-radius: 6px;
                    transition: background 0.2s;
                }

                    .notif-header-actions button:hover {
                        background: #E7E4D9;
                    }

            .notif-list {
                max-height: 400px;
                overflow-y: auto;
            }

                .notif-list::-webkit-scrollbar {
                    width: 5px;
                }

                .notif-list::-webkit-scrollbar-thumb {
                    background: #D5CFB8;
                    border-radius: 10px;
                }

            .notif-item {
                display: flex;
                gap: 12px;
                padding: 14px 18px;
                border-bottom: 1px solid #f5f5f5;
                transition: background 0.2s;
                cursor: pointer;
                text-decoration: none;
                color: inherit;
            }

                .notif-item:hover {
                    background: #FAF9F4;
                }

                .notif-item.unread {
                    background: #FFFDF5;
                    border-left: 3px solid var(--accent-color);
                }

            .notif-icon {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 16px;
            }

                .notif-icon.info {
                    background: #d1ecf1;
                    color: #0c6b7c;
                }

                .notif-icon.success {
                    background: #d4edda;
                    color: #155724;
                }

                .notif-icon.warning {
                    background: #fff3cd;
                    color: #856404;
                }

                .notif-icon.danger {
                    background: #f8d7da;
                    color: #721c24;
                }

            .notif-content {
                flex: 1;
                min-width: 0;
            }

                .notif-content .notif-title {
                    font-size: 13.5px;
                    font-weight: 700;
                    color: var(--primary-color);
                    margin: 0 0 2px;
                    line-height: 1.3;
                }

                .notif-content .notif-message {
                    font-size: 12.5px;
                    color: #6B7568;
                    margin: 0 0 4px;
                    line-height: 1.4;
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }

                .notif-content .notif-time {
                    font-size: 11px;
                    color: #8A9188;
                }

            .notif-empty {
                text-align: center;
                padding: 40px 20px;
                color: #8A9188;
            }

                .notif-empty i {
                    font-size: 36px;
                    color: #E7E4D9;
                    margin-bottom: 10px;
                    display: block;
                }

                .notif-empty p {
                    margin: 0;
                    font-size: 13px;
                }

            .notif-footer {
                padding: 10px 18px;
                border-top: 1px solid #f0f0f0;
                background: #FAF9F4;
                text-align: center;
            }

                .notif-footer a {
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--primary-color);
                    text-decoration: none;
                }

                    .notif-footer a:hover {
                        text-decoration: underline;
                    }

            @@media (max-width: 576px) {
                .notif-dropdown {
                    width: 320px;
                    right: -60px;
                }
            }

            /* ===== Smooth Page Transition ===== */
            @@media (prefers-reduced-motion: no-preference) {
                @@view-transition {
                    navigation: auto;
                }
            }

            ::view-transition-old(root),
            ::view-transition-new(root) {
                animation-duration: 0.3s;
                animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            }

            @@keyframes pageEnter {
                from {
                    opacity: 0;
                    transform: translateY(12px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            html.no-vt main {
                animation: pageEnter 0.4s cubic-bezier(0.22, 1, 0.36, 1) backwards;
                transition: opacity 0.2s ease, transform 0.2s ease;
            }

                html.no-vt main.page-leaving {
                    opacity: 0;
                    transform: translateY(-6px);
                    pointer-events: none;
                }

            #pageProgress {
                position: fixed;
                top: 0;
                left: 0;
                height: 3px;
                width: 0;
                background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
                z-index: 9999;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.2s ease;
            }

                #pageProgress.active {
                    opacity: 1;
                    width: 75%;
                    transition: width 6s cubic-bezier(0.1, 0.6, 0.2, 1), opacity 0.2s ease;
                }

            /* ===== Smooth Buttons ===== */
            button,
            .btn,
            a.rounded-full {
                transition-property: color, background-color, border-color, opacity, box-shadow, transform;
                transition-duration: 0.2s;
                transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            }

                .btn-primary-custom:hover,
                a.rounded-full[style*="background-color"]:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(31, 59, 44, 0.22);
                }

                button:not(:disabled):active,
                .btn:not(:disabled):active,
                a.rounded-full:active,
                .btn-primary-custom:active,
                a.rounded-full[style*="background-color"]:active {
                    transform: scale(0.96);
                    box-shadow: none;
                }

                button:focus-visible,
                .btn:focus-visible,
                a.rounded-full:focus-visible {
                    outline: 2px solid var(--primary-color);
                    outline-offset: 2px;
                }

            @@media (prefers-reduced-motion: reduce) {
                html.no-vt main {
                    animation: none;
                    transition: none;
                }

                    html.no-vt main.page-leaving {
                        transform: none;
                    }

                #pageProgress.active {
                    transition: none;
                }

                button, .btn, a.rounded-full {
                    transition: none;
                }

                    button:active, .btn:active, a.rounded-full:active,
                    .btn-primary-custom:hover, .btn-primary-custom:active,
                    a.rounded-full[style*="background-color"]:hover,
                    a.rounded-full[style*="background-color"]:active {
                        transform: none;
                    }
            }

            /* ===== ✅ Logo (Dynamic size/shape from settings) ===== */
            .brand-logo {
                width: @(safeLogoSize)px;
                height: @(safeLogoSize)px;
                object-fit: cover;
                border-radius: @(logoRadius);
                flex-shrink: 0;
                transition: transform 0.2s ease;
            }

                .brand-logo:hover {
                    transform: scale(1.04);
                }

            .brand-site-name {
                color: var(--primary-color);
                font-weight: 700;
                letter-spacing: 0.3px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 220px;
            }

            .footer-brand-logo {
                width: @(safeLogoSize)px;
                height: @(safeLogoSize)px;
                object-fit: cover;
                border-radius: @(logoRadius);
                flex-shrink: 0;
            }

            @@media (max-width: 768px) {
                .brand-site-name {
                    display: none;
                }
            }
    </style>
</head>
<body>

    <!-- Page transition loading bar -->
    <div id="pageProgress"></div>

    <!-- ========================================= -->
    <!-- NAVBAR -->
    <!-- ========================================= -->
    <header class="sticky-top z-50 border-b border-black/5" style="background-color:var(--navbar-bg);">
        <nav class="max-w-[1440px] mx-auto px-4 sm:px-6 xl:px-8">
            <div class="h-20 flex items-center justify-between gap-4">

                <!-- ✅ Logo + Site Name (Dynamic) -->
                <div class="flex-shrink-0">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                        <img src="@navbarLogo"
                             alt="@safeSiteName logo"
                             class="brand-logo" />
                        <span class="brand-site-name hidden sm:inline font-serif"
                              style="font-size:16px;">
                            @safeSiteName
                        </span>
                    </a>
                </div>

                <!-- Desktop Menu -->
                <div class="hidden xl:flex items-center gap-5 2xl:gap-8">
                    <a asp-controller="Home" asp-action="Index" class="nav-desktop-link text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">
                        <i class="fas fa-house me-1" style="font-size:12px;"></i>Home
                    </a>
                    <a asp-controller="FindTutor" asp-action="Index" class="nav-desktop-link text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">
                        <i class="fas fa-chalkboard-user me-1" style="font-size:12px;"></i>Find Tutor
                    </a>
                    <a asp-controller="Tuition" asp-action="Circular" class="nav-desktop-link text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">
                        <i class="fas fa-clipboard-list me-1" style="font-size:12px;"></i>Tuition Circular
                    </a>
                    <a asp-controller="Notice" asp-action="Index" class="nav-desktop-link text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">
                        <i class="fas fa-bullhorn me-1" style="font-size:12px;"></i>Notice
                    </a>
                    <a asp-controller="Helpdesk" asp-action="Index" class="nav-desktop-link text-sm font-medium transition hover:opacity-70" style="color:#4B5648;">
                        <i class="fas fa-headset me-1" style="font-size:12px;"></i>Helpdesk
                    </a>
                </div>

                <!-- Desktop Right Side -->
                <div class="hidden xl:flex items-center flex-shrink-0">
                    @if (Context.Session.GetString("UserName") != null)
                    {
                        var userRole = Context.Session.GetString("UserRole");
                        var isTeacher = userRole == "Teacher";
                        var isAdmin = userRole == "Admin";
                        var userFullName = Context.Session.GetString("UserFullName") ?? Context.Session.GetString("UserName");

                        <!-- Notification Bell -->
                        <div class="notification-wrapper" id="notifWrapper">
                            <button class="notification-bell" id="notifBell" type="button" title="Notifications">
                                <i class="fas fa-bell"></i>
                                <span class="notif-badge" id="notifBadge">0</span>
                            </button>
                            <div class="notif-dropdown" id="notifDropdown">
                                <div class="notif-header">
                                    <h6><i class="fas fa-bell me-1"></i>Notifications</h6>
                                    <div class="notif-header-actions">
                                        <button onclick="markAllRead()" title="Mark all as read">
                                            <i class="fas fa-check-double"></i> Mark all read
                                        </button>
                                        <button onclick="clearAllNotifications()" title="Clear all">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="notif-list" id="notifList">
                                    <div class="notif-empty">
                                        <i class="fas fa-spinner fa-spin"></i>
                                        <p>Loading...</p>
                                    </div>
                                </div>
                                <div class="notif-footer">
                                    <a href="/Notification/All">View All Notifications</a>
                                </div>
                            </div>
                        </div>

                        <div class="profile-dropdown dropdown" id="profileDropdown">
                            <button class="dropdown-toggle" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle"></i>
                                <span>@userFullName</span>
                                <span class="caret"><i class="fas fa-chevron-down"></i></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
                                <li class="dropdown-header">
                                    @userFullName
                                    <small>@Context.Session.GetString("UserName")</small>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                        <i class="fas fa-id-card"></i> My Profile
                                    </a>
                                </li>
                                
                                @if (isTeacher)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Teacher" asp-action="TeacherDashboard">
                                            <i class="fas fa-chalkboard-teacher"></i> Teacher Dashboard
                                            <span class="badge-role teacher">Teacher</span>
                                        </a>
                                    </li>
                                }
                                @if (isAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="fas fa-shield-alt"></i> Admin Panel
                                            <span class="badge-role admin">Admin</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Settings">
                                            <i class="fas fa-cog"></i> Site Settings
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" id="logoutFormDesktop">
                                        @Html.AntiForgeryToken()
                                        <a class="dropdown-item text-danger" href="#" onclick="document.getElementById('logoutFormDesktop').submit(); return false;">
                                            <i class="fas fa-sign-out-alt"></i> Logout
                                        </a>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2">
                            <a asp-controller="Account" asp-action="Login" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full font-semibold text-white text-sm transition hover:opacity-90" style="background-color:var(--primary-color);">
